[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://speex_live.gd" id="1"]

[sub_resource type="AudioStreamMicrophone" id="AudioStreamMicrophone_mic"]

[node name="SpeexLive" type="Control"]
layout_mode = 3
anchors_preset = 15
