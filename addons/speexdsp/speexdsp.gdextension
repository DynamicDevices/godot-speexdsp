[configuration]
entry_symbol = "speexdsp_library_init"
compatibility_minimum = "4.5"

; SpeexDSP is compiled into the extension (resampler only for now). No extra [dependencies].

[libraries]
linux.debug.x86_64 = "./bin/libspeexdsp.linux.template_debug.x86_64.so"
linux.release.x86_64 = "./bin/libspeexdsp.linux.template_release.x86_64.so"
windows.debug.x86_64 = "./bin/libspeexdsp.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "./bin/libspeexdsp.windows.template_release.x86_64.dll"
macos.debug = "./bin/libspeexdsp.macos.template_debug.framework"
macos.release = "./bin/libspeexdsp.macos.template_release.framework"
